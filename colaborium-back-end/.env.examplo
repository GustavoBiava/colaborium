# COLABORIUM - CONFIGURAÇÕES DO AMBIENTE

NODE_ENV=development

# Porta em que o servidor Fastify será executado.
# Deve corresponder à porta configurada no Docker Compose.
PORT=3333

# POSTGRESQL - CONFIGURAÇÕES DO BANCO

# Endereço do servidor PostgreSQL.
# localhost = banco instalado na própria máquina.
# No Docker Compose, o backend utiliza host.docker.internal.
# Na VPS, configurar conforme o ambiente de produção.
DB_HOST=localhost

# Porta utilizada pelo PostgreSQL.
# Padrão: 8080. Altere conforme sua instalação (caso não saiba no pgadmin: SHOW port;).
DB_PORT=0000

# Nome do banco de dados utilizado pelo sistema.
DB_NAME=colaborium

# Usuário utilizado para conectar ao PostgreSQL.
# Em produção, devemos criar um usuário próprio da aplicação.
DB_USER=postgres

# Senha do usuário PostgreSQL.
# Substitua pela senha configurada na sua máquina.
DB_PASSWORD=SUA_SENHA