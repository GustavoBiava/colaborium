{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "colaborium-front-end": {
      "root": "colaborium-front-end/",
      "framework": "vite"
    },
    "colaborium-back-end": {
      "root": "colaborium-back-end/",
      "framework": "fastify",
      "entrypoint": "src/server.ts"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": { "service": "colaborium-back-end" }
    },
    {
      "source": "/(.*)",
      "destination": { "service": "colaborium-front-end" }
    }
  ]
}
